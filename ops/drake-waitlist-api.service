[Unit]
Description=Drake portfolio waitlist API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=drake-waitlist
Group=drake-waitlist
WorkingDirectory=/opt/drake-waitlist-api
Environment=PYTHONUNBUFFERED=1
Environment=WAITLIST_HOST=0.0.0.0
Environment=WAITLIST_PORT=8443
Environment=WAITLIST_DB_PATH=/var/lib/drake-waitlist/waitlist.sqlite3
Environment=WAITLIST_ALLOWED_ORIGINS=https://www.drakestapleton.com,https://drakestapleton.com
Environment=WAITLIST_CERT_PATH=/etc/drake-waitlist/tls/fullchain.pem
Environment=WAITLIST_KEY_PATH=/etc/drake-waitlist/tls/privkey.pem
EnvironmentFile=-/etc/drake-waitlist/release.env
ExecStart=/usr/bin/python3 /opt/drake-waitlist-api/server/waitlist_api.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallArchitectures=native
ReadWritePaths=/var/lib/drake-waitlist

[Install]
WantedBy=multi-user.target
